# ============================================================
# docker compose 用的環境變數範本
#
# 用法：
#   本機開發 → 複製為 .env.local（docker-compose.override.yml 引用）
#   正式環境 → 內容放在 bms-prod-02 的 /opt/edms/.env.prod，**不放 repo 內**
#              （vm-deploy.sh 會在部署時複製進來，該檔已由 .gitignore 擋住）
#
# ⚠️ 本 repo 為 public：實際值一律不得進 git。
# ⚠️ 金鑰不得與 TBMS 共用——EDMS 認證獨立、資料庫也獨立。
#
# 註：backend/.env.example 與 frontend/.env.example 供「不透過 docker」直接
#     跑起服務時使用；本檔是 docker compose 這條路徑用的。
# ============================================================

# ── PostgreSQL 容器初始化 ────────────────────────────────────
POSTGRES_USER=edms
POSTGRES_PASSWORD=change-me
POSTGRES_DB=edms

# ── 後端 ─────────────────────────────────────────────────────
# host 固定為 edms-db（compose service name），非 localhost
DATABASE_URL=postgresql+asyncpg://edms:change-me@edms-db:5432/edms

APP_NAME=EDMS
DEBUG=false

# 🔴 線上自 2026-09-22 起改以 URL 路徑分流（https://bms.tbsf.tw/edms/），
#    FRONTEND_BASE_URL **必須帶 /edms**：
#
#      FRONTEND_BASE_URL=https://bms.tbsf.tw/edms
#
#    它是開通信與重設信裡連結的起點，少了 /edms 使用者會點進系統入口的
#    導覽頁而不是 EDMS 的登入頁。production 的啟動護欄只擋 localhost，
#    **不會檢查路徑前綴**，漏帶要等有人點信才會發現。
#
# ℹ️ CORS_ORIGINS 線上用不到：前端的 VITE_API_BASE_URL 是相對路徑
#   （/edms/api），頁面與 API 同一個 origin，同源請求不觸發 CORS。
#    正式環境的 .env.prod 沒設它是正常的（本欄位有預設值，不擋啟動）。
#    要設的話 origin 依規格只有 scheme://host:port：https://bms.tbsf.tw
#
# 本機依 override 的 port 而定。
CORS_ORIGINS=http://localhost:8090
FRONTEND_BASE_URL=http://localhost:8090

# 各環境獨立產生，不得沿用他人或他環境的值
JWT_SECRET_KEY=change-me-generate-per-environment
# Base64、解碼後須為 32 bytes
ENCRYPTION_KEY=change-me-generate-per-environment

# ── 檔案儲存 ─────────────────────────────────────────────────
# DM 受控文件與 ET 影音教材的存放根目錄。
# production（DEBUG=false）下**必須為絕對路徑**——相對路徑依 process 工作目錄
# 解析，換啟動位置就讀不到既有檔案。
# 這兩個路徑在正式環境對應 /opt/edms/data/{dm_files,et_videos} 的 bind mount。
DM_FILE_STORAGE_ROOT=/app/var/dm_files
ET_VIDEO_STORAGE_ROOT=/app/var/et_videos

# ── 備份（僅正式環境需要）────────────────────────────────────
# scripts/db-backup.sh 未取得此值會直接失敗——備份是 migration 的前提
EDMS_BACKUP_BUCKET=gs://edms-db-backup
